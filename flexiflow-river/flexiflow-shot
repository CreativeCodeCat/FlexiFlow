#!/bin/sh
# flexiflow-shot: screenshots on flexiflow-river with grim, taking
# win-shot's flags so the same key bindings work:
#
#   flexiflow-shot -w   the focused window
#   flexiflow-shot -s   a region picked with slurp
#   flexiflow-shot -f   the whole screen
#
# Each is saved to $FLEXIFLOW_SHOT_DIR (~/Pictures/Screenshots by
# default), copied to the clipboard, and announced with notify-send.

set -u

dir=${FLEXIFLOW_SHOT_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots}
mkdir -p "$dir" || exit 1
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png

case ${1:-} in
-w)
	focused=$(flexiflow-river --focused) || {
		notify-send -a flexiflow-shot "Screenshot" "No focused window"
		exit 1
	}
	id=${focused%% *}
	geometry=${focused#* }
	# by identifier, so even a covered window is captured whole; by
	# geometry if this grim can't
	grim -T "$id" "$file" 2>/dev/null || grim -g "$geometry" "$file"
	;;
-s)
	# Escape in slurp takes no screenshot
	region=$(slurp) || exit 0
	grim -g "$region" "$file"
	;;
-f)
	grim "$file"
	;;
*)
	echo "usage: flexiflow-shot -w | -s | -f" >&2
	exit 2
	;;
esac || {
	notify-send -a flexiflow-shot "Screenshot failed"
	exit 1
}

wl-copy --type image/png <"$file"
notify-send -a flexiflow-shot -i "$file" "Screenshot saved" "$file"
