#!/usr/bin/env bash

# Each line is "item<TAB>command" - xmenu's own format for showing one
# thing but echoing another when it's picked. The number after the tab
# is the index key_handlers.rs's layoutmenu() reads back and passes to
# setlayout(); it must match src/config.lua's `layouts` table position
# for position, symbol for symbol - keep the two in sync by hand if you
# reorder, add, or remove a layout there.
cat <<'EOF' | xmenu
[]= Tiled Layout	0
[M] Monocle Layout	1
[@] Spiral Layout	2
[D] Dwindle Layout	3
H[] Deck Layout	4
TTT Stack Layout	5
=== Stack Horz Layout	6
HHH Grid Layout	7
### Narrow Grid Layout	8
--- Grid Horz Layout	9
::: Gapless Grid Layout	10
|M| Centered Master Layout	11
>M> Centered Floating Layout	12
><> NULL Layout	13
EOF