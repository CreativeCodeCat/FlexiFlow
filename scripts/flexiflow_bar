#!/usr/bin/env bash

# path:       /usr/bin/flexiflow_bar
# author:     The-Repo-Club [wayne6324@gmail.com]
# github:     https://github.com/The-Repo-Club/flexiflow
# date:       2021-04-10 12:34:47.440579
#
# Self-contained status bar for flexiflow (status2d patch, ^c^/^b^ color codes).
# Every segment that used to live in examples/bar_* is inlined below, and the
# color theme (previously sourced from the never-shipped
# ~/.config/flexiflow_bar/bar_themes/minimal-mistakes) is defined directly.
# Segments whose optional dependency isn't installed (yay, a battery, pactl)
# just omit themselves instead of erroring.
#
# Vendored into flexiflow-rs (../FlexiFlow/flexiflow_bar is the original,
# untouched, for the C flexiflow build) with one change below: it now
# talks to `flexiflow-rs -s`, which parses the same ^c^/^b^ codes in
# core.rs's drawbar instead of flexiflow.c's drawstatusbar.

# ---- theme (matches themes/minimal-mistakes.h accents) --------------------
Foreground="#283036"

Purple="#A165E8";  Purple_Bright="#C9A4FF"
Cyan="#2BC4C9";    Cyan_Bright="#59FFF9"
Green="#3DBD3D";   Green_Bright="#59FF59"
Yellow="#D4C94A";  Yellow_Bright="#FFFF59"
Orange="#E0813A";  Orange_Bright="#FF9C59"
Pink="#D136C9";    Pink_Bright="#FF59F9"
Red="#CC3333";     Red_Bright="#FF5959"

Sep_Fg="#434C5E"; Sep_Bg="#283036"

# ---- segments ---------------------------------------------------------

seg_sep() {
  printf "^c%s^^b%s^ \n" "$Sep_Fg" "$Sep_Bg"
}

seg_updates() {
  command -v paru >/dev/null 2>&1 || return 0

  local configFile="$HOME/.config/flexiflow/flexiflow_bar/bar_updates.ini"
  local icon="" timestamp updates updatecount LastUsed Message

  timestamp=$(date +%s)
  [[ -f $configFile ]] && . "$configFile"

  if [[ -z $LastUsed || -z $Message || $timestamp -ge $LastUsed ]]; then
    updates=$(paru -Qu 2>/dev/null | wc -l)
    if ((updates == 0)); then
      updatecount="Fully Updated"
    elif ((updates == 1)); then
      updatecount="$updates Update"
    else
      updatecount="$updates Updates"
    fi
    mkdir -p "$(dirname "$configFile")"
    printf 'LastUsed=%s\nMessage="%s"\n' "$((timestamp + 900))" "$updatecount" >"$configFile"
  else
    updatecount="$Message"
  fi

  printf " %s %s \n" "^c$Foreground^^b$Purple^ $icon " "^c$Foreground^^b$Purple_Bright^ $updatecount"
}

seg_kernel() {
  local icon="  " kernel
  kernel=$(uname -r)
  printf " %s %s \n" "^c$Foreground^^b$Cyan^$icon" "^c$Foreground^^b$Cyan_Bright^ $kernel"
}

seg_battery() {
  local bat batdir status charge icon
  for bat in BAT0 BAT1 BAT; do
    if [[ -d /sys/class/power_supply/$bat ]]; then
      batdir="/sys/class/power_supply/$bat"
      break
    fi
  done
  [[ -z $batdir ]] && return 0

  charge=$(<"$batdir/capacity")
  status=$(<"$batdir/status")

  if [[ $status != "Discharging" ]]; then
    icon=" 󰂄"
  elif ((charge > 90)); then
    icon=" 󰁹 "
  elif ((charge > 80)); then
    icon=" 󰂂 "
  elif ((charge > 70)); then
    icon=" 󰂁 "
  elif ((charge > 60)); then
    icon=" 󰂀 "
  elif ((charge > 50)); then
    icon=" 󰁿 "
  elif ((charge > 40)); then
    icon=" 󰁾 "
  elif ((charge > 30)); then
    icon=" 󰁽 "
  elif ((charge > 20)); then
    icon=" 󰁼 "
  elif ((charge > 10)); then
    icon=" 󰁻 "
  else
    icon=" 󰁺 "
  fi

  printf " %s %s \n" "^c$Foreground^^b$Green^$icon" "^c$Foreground^^b$Green_Bright^ ${charge}%"
}

seg_ram() {
  local icon=" 󰍛 " ram
  ram=$(free -h | awk '/Mem:/ { print $3 }')
  ram=${ram%i*}
  printf " %s %s \n" "^c$Foreground^^b$Yellow^$icon" "^c$Foreground^^b$Yellow_Bright^ $ram"
}

seg_cpu() {
  local icon="  " a b c previdle idle total prevtotal cpu
  read -r _ a b c previdle _ </proc/stat
  prevtotal=$((a + b + c + previdle))
  sleep 0.5
  read -r _ a b c idle _ </proc/stat
  total=$((a + b + c + idle))
  cpu=$((100 * ((total - prevtotal) - (idle - previdle)) / (total - prevtotal)))

  printf " %s %s \n" "^c$Foreground^^b$Orange^$icon" "^c$Foreground^^b$Orange_Bright^ $cpu%"
}

seg_keyboard() {
  local icon=" 󰌌 " keyboard
  keyboard="$(setxkbmap -query | awk '/layout/{print $2}')"
  keyboard="${keyboard^^}"
  printf " %s %s \n" "^c$Foreground^^b$Pink^$icon" "^c$Foreground^^b$Pink_Bright^ $keyboard"
}

seg_desktop() {
  local icon="  " desktop id
  if [[ -n $XDG_CURRENT_DESKTOP ]]; then
    desktop="$XDG_CURRENT_DESKTOP"
  elif [[ -n $XDG_SESSION_DESKTOP ]]; then
    desktop="$XDG_SESSION_DESKTOP"
  elif [[ -n $DESKTOP_SESSION ]]; then
    desktop="$DESKTOP_SESSION"
  else
    id=$(xprop -root -notype _NET_SUPPORTING_WM_CHECK)
    id=${id##* }
    desktop=$(xprop -id "$id" -notype -len 100 -f _NET_WM_NAME 8t)
    desktop=${desktop/*WM_NAME = /}
    desktop=${desktop/\"/}
    desktop=${desktop/\"*/}
    desktop=$(sed 's/[\].*$//' <<<"$desktop")
  fi

  [[ -z $desktop ]] && desktop="Can not detect desktop"

  printf " %s %s \n" "^c$Foreground^^b$Red^$icon" "^c$Foreground^^b$Red_Bright^ $desktop"
}

seg_network() {
  local state
  state=$(cat /sys/class/net/wl*/operstate 2>/dev/null | head -n1)
  [[ -z $state ]] && return 0

  if [[ $state == "up" ]]; then
    printf " %s %s \n" "^c$Foreground^^b$Purple^  " "^c$Foreground^^b$Purple_Bright^ Connected"
  else
    printf " %s %s \n" "^c$Foreground^^b$Purple^ 󰖪 " "^c$Foreground^^b$Purple_Bright^ Disconnected"
  fi
}

seg_volume() {
  command -v pactl >/dev/null 2>&1 || return 0

  local vol icon

  if pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q "yes"; then
    printf " %s %s \n" "^c$Foreground^^b$Cyan^ 󰝟 " "^c$Foreground^^b$Cyan_Bright^ muted"
    return 0
  fi

  vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '{print $5; exit}' | tr -d '%')
  [[ -z $vol ]] && return 0

  if ((vol >= 75)); then
    icon=$' '
  elif ((vol >= 50)); then
    icon="󰕾 "
  elif ((vol >= 25)); then
    icon="󰖀 "
  else
    icon="󰕿 "
  fi

  printf " %s %s \n" "^c$Foreground^^b$Cyan^$icon" "^c$Foreground^^b$Cyan_Bright^ $vol%"
}

DaySuffix() {
  local day
  day=$(date +%-d)
  case $day in
  1 | 21 | 31) echo "st" ;;
  2 | 22) echo "nd" ;;
  3 | 23) echo "rd" ;;
  *) echo "th" ;;
  esac
}

seg_clock() {
  local icon_date="  " icon_time=" " date time
  date=$(date +" %-d$(DaySuffix) %b %Y")
  time=$(date +" %I:%M %P")

  printf " %s %s %s %s \n" "^c$Foreground^^b$Green^$icon_date" "^c$Foreground^^b$Green_Bright^$date" "^c$Foreground^^b$Green^$icon_time" "^c$Foreground^^b$Green_Bright^$time"
}

main() {
  pid=$(pgrep -f flexiflow_bar | grep -x -v $$)

  for i in $pid; do
    if kill -0 "$i" 2>/dev/null; then
      kill "$i"
    fi
  done

  while true; do
    top="$(seg_updates)$(seg_sep)$(seg_kernel)$(seg_sep)$(seg_battery)$(seg_sep)$(seg_ram)$(seg_sep)$(seg_cpu)$(seg_sep)$(seg_keyboard)$(seg_sep)$(seg_desktop)$(seg_sep)$(seg_network)$(seg_sep)$(seg_volume)$(seg_sep)$(seg_clock)"

    flexiflow-rs -s "$top"
    sleep 0.5s
  done
}

main
